#: apps/users/services/accounts.py:64 apps/users/services/accounts.py:78
#: apps/users/services/accounts.py:127 apps/users/services/accounts.py:168
msgid "Користувач з таким email вже існує."
msgstr "इस ईमेल वाला उपयोगकर्ता पहले से मौजूद है।"

#: apps/users/services/accounts.py:98
msgid "Підтвердіть email у Poruch"
msgstr "Poruch में अपना ईमेल पुष्टि करें"

#: apps/users/services/accounts.py:99
msgid "Вітаємо у Poruch!"
msgstr "Poruch में आपका स्वागत है!"

#: apps/users/services/accounts.py:102
msgid ""
"Залишився один крок: підтвердьте свою електронну адресу, щоб просити про "
"допомогу й допомагати людям поруч."
msgstr ""
"बस एक क़दम बाकी है: मदद माँगने और पास के लोगों की मदद करने के लिए अपना ईमेल "
"पता पुष्टि करें।"

#: apps/users/services/accounts.py:105 apps/users/services/accounts.py:177
msgid "Підтвердити email"
msgstr "ईमेल पुष्टि करें"

#: apps/users/services/accounts.py:107
msgid ""
"Посилання дійсне 3 дні. Якщо ви не реєструвалися в Poruch — просто "
"проігноруйте цей лист."
msgstr ""
"लिंक 3 दिन तक मान्य है। अगर आपने Poruch में रजिस्टर नहीं किया, तो इस ईमेल को"
" अनदेखा करें।"

#: apps/users/services/accounts.py:115
msgid "Посилання застаріло."
msgstr "लिंक की अवधि ख़त्म हो गई।"

#: apps/users/services/accounts.py:117 apps/users/services/accounts.py:120
#: apps/users/services/accounts.py:125 apps/users/services/accounts.py:216
msgid "Недійсне посилання."
msgstr "अमान्य लिंक।"

#: apps/users/services/accounts.py:147 apps/users/services/accounts.py:164
#: apps/users/services/deletion.py:32
msgid "Неправильний пароль."
msgstr "ग़लत पासवर्ड।"

#: apps/users/services/accounts.py:166
msgid "Це ваша поточна адреса."
msgstr "यह आपका मौजूदा पता है।"

#: apps/users/services/accounts.py:174
msgid "Підтвердіть нову адресу в Poruch"
msgstr "Poruch में अपना नया पता पुष्टि करें"

#: apps/users/services/accounts.py:175
msgid "Нова електронна адреса"
msgstr "नया ईमेल पता"

#: apps/users/services/accounts.py:176
msgid ""
"Ви змінюєте email свого акаунта Poruch. Підтвердіть, що ця адреса ваша."
msgstr ""
"आप अपने Poruch खाते का ईमेल बदल रहे हैं। पुष्टि करें कि यह पता आपका है।"

#: apps/users/services/accounts.py:179
msgid ""
"Якщо це були не ви — просто проігноруйте цей лист, нічого не зміниться."
msgstr "अगर यह आपने नहीं किया, तो इस ईमेल को अनदेखा करें — कुछ नहीं बदलेगा।"

#: apps/users/services/accounts.py:193
msgid ""
"Ви запросили відновлення пароля в Poruch. Натисніть кнопку, щоб встановити "
"новий."
msgstr ""
"आपने Poruch का पासवर्ड रीसेट करने का अनुरोध किया है। नया पासवर्ड सेट करने के"
" लिए बटन दबाएँ।"

#: apps/users/services/accounts.py:196
msgid ""
"Ви входили в Poruch через Google, тому пароля у вас ще немає. Натисніть "
"кнопку, щоб створити його — тоді зможете входити і за email, і через Google."
msgstr ""
"आपने Poruch में Google से लॉग इन किया था, इसलिए आपका अभी कोई पासवर्ड नहीं "
"है। पासवर्ड बनाने के लिए बटन दबाएँ — फिर आप ईमेल और Google दोनों से लॉग इन "
"कर सकेंगे।"

#: apps/users/services/accounts.py:202
msgid "Відновлення пароля в Poruch"
msgstr "Poruch का पासवर्ड रीसेट करें"

#: apps/users/services/accounts.py:203
msgid "Новий пароль"
msgstr "नया पासवर्ड"

#: apps/users/services/accounts.py:205
msgid "Встановити новий пароль"
msgstr "नया पासवर्ड सेट करें"

#: apps/users/services/accounts.py:207
msgid "Якщо це були не ви — проігноруйте цей лист, ваш пароль не зміниться."
msgstr ""
"अगर यह आपने नहीं किया, तो इस ईमेल को अनदेखा करें — आपका पासवर्ड नहीं बदलेगा।"

#: apps/users/services/accounts.py:218
msgid "Недійсне або застаріле посилання."
msgstr "अमान्य या पुराना लिंक।"

#: apps/users/services/accounts.py:238 apps/users/services/accounts.py:256
msgid "Вхід через Google не налаштовано."
msgstr "Google से लॉग इन सेट नहीं है।"

#: apps/users/services/accounts.py:242 apps/users/services/accounts.py:273
msgid "Не вдалося перевірити обліковий запис Google."
msgstr "Google खाते की जाँच नहीं हो सकी।"

#: apps/users/services/accounts.py:282
msgid "Email Google-акаунта не підтверджено."
msgstr "Google खाते का ईमेल पुष्टि नहीं हुआ है।"

#: apps/users/services/accounts.py:308
msgid "Обліковий запис деактивовано."
msgstr "खाता निष्क्रिय है।"

#: apps/users/services/deletion.py:62
