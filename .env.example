# ---------------------------------------------------------------------------
# Poruch — environment variables. Copy to .env and adjust. Never commit .env.
# Values below work for local development with docker compose.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=change-me-dev-only-secret-key-please-replace-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
# Public base for share links (e.g. https://poruch.app → https://poruch.app/r/<code>)
SHARE_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
API_DOCS_PUBLIC=true

# Database (PostGIS). Inside docker compose the host is "postgres".
POSTGRES_DB=poruch
POSTGRES_USER=poruch
POSTGRES_PASSWORD=poruch
DATABASE_URL=postgis://poruch:poruch@localhost:5432/poruch

# Redis (cache, channels, celery broker/results, rate limiting)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# S3-compatible storage (SeaweedFS locally, credentials in infra/seaweedfs/s3.json)
AWS_ACCESS_KEY_ID=poruch
AWS_SECRET_ACCESS_KEY=poruch-secret
AWS_STORAGE_BUCKET_NAME=poruch-media
AWS_REGION=us-east-1
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Web Push (generate with: python backend/manage.py generate_vapid_keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@poruch.local

# Google OAuth (Google Identity Services, "Web application" client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Mailpit locally: UI at http://localhost:8025)
EMAIL_URL=smtp://localhost:1025
SUPPORT_EMAIL=support@example.com
# Encrypts phone numbers at rest (Fernet key). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a copy outside the server: without it phones in database backups cannot be read.
FIELD_ENCRYPTION_KEY=
DEFAULT_FROM_EMAIL=Poruch <no-reply@poruch.local>

# Rate limits (DRF throttle format)
RATE_LIMIT_LOGIN=5/minute
# Spec default is 5/hour per IP; raised for local development and E2E runs.
RATE_LIMIT_REGISTER=30/hour
RATE_LIMIT_CREATE_HELP_REQUEST=10/hour
RATE_LIMIT_RESPOND=30/hour
RATE_LIMIT_MESSAGES=60/minute
NOTIFICATION_NEARBY_LIMIT_PER_HOUR=10

# Logging
LOG_LEVEL=INFO

# Frontend (Vite) — map tiles provider is configurable
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_DEFAULT_LOCALE=uk
# Public URL of the site (Open Graph, robots.txt, sitemap.xml). Production uses FRONTEND_URL.
VITE_SITE_URL=http://localhost:5173
